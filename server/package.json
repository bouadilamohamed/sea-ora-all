{
  "name": "seaora-server",
  "version": "2.0.0",
  "private": true,
  "description": "SEAORA — La Perle: Express API over PostgreSQL (Prisma).",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma || echo \"prisma generate skipped — run npm run db:generate from the project root\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "seaora-la-perle": "file:..",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
