// ============================================================
// SEAORA — La Perle
// PostgreSQL schema.
//
// The original SQLite database kept four parallel tables — images, audios,
// videos, notes — each with its own position column, and the viewer merged
// them into a single pile at read time. Here they are one `Memory` table
// discriminated by `type`, which is the same data with one ordering, one set
// of CRUD endpoints and one place to add a fifth kind of memory later.
// The four piles are still four piles: they are `type` filters ordered by
// `position`, exactly as the experience expects.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A pearl is one gift: the sealed door, the letter, and its memories.
model Pearl {
  id     Int         @id @default(autoincrement())
  slug   String      @unique
  status PearlStatus @default(SEALED)

  /// The one credential that opens the gift. scrypt, never in clear.
  passHash String  @map("pass_hash")
  passSalt String  @map("pass_salt")
  /// An optional word shown on the gate when the visitor is stuck.
  passHint String? @map("pass_hint")

  /// Optional SECOND secret — the reference engraved on the object. When it
  /// is set, the gate asks for it in addition to the code. Hashed like the
  /// code: the value never leaves the database, only the `needsRef` boolean.
  refHash String? @map("ref_hash")
  refSalt String? @map("ref_salt")

  /// The same reference under a keyed digest, so that it can be UNIQUE.
  ///
  /// `refHash` cannot answer "does this reference already exist?" — every row
  /// carries its own salt, so the same reference hashes differently each
  /// time. This is one deterministic value per reference, peppered from the
  /// environment so a stolen database still does not give the references
  /// back. It is what the unique index below is built on; verification at the
  /// gate still goes through `refHash`.
  refKey String? @unique @map("ref_key")

  /// The temporary password an administrator hands to the customer so they
  /// can fill the gift. Erased in the same transaction that seals it.
  tempHash String? @map("temp_hash")
  tempSalt String? @map("temp_salt")

  /// Held by whoever created the pearl; required by the manage endpoints.
  manageKey String @map("manage_key")

  title     String  @default("Pour toi")
  subtitle  String  @default("")
  gateTitle String  @default("Coquillage scellé") @map("gate_title")
  gateNote  String  @default("Entrez le code secret pour révéler la perle") @map("gate_note")
  /// The letter shown under every memory once the pearl is open.
  message   String  @default("")
  autoplay  Boolean @default(true)

  views   Int @default(0)
  unlocks Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memories Memory[]
  sessions Session[]

  @@map("pearls")
}

enum PearlStatus {
  /// Generated by an administrator, not yet filled: the gate refuses to open.
  DRAFT
  /// Finished by its owner. The only state the viewer will unlock.
  SEALED
}

enum MemoryType {
  PHOTO
  VIDEO
  VOICE
  NOTE
}

/// One memory in the pile. Every kind lives here; `type` says which fields
/// carry meaning:
///
///   PHOTO  title=handwritten caption · mediaUrl=full webp · thumbnailUrl
///   VIDEO  title=label · mediaUrl=film · posterUrl=frame · duration
///   VOICE  title=label · mediaUrl=audio · duration
///   NOTE   title=title · date=free text ("Été 2019") · description=the page
model Memory {
  id      Int        @id @default(autoincrement())
  pearlId Int        @map("pearl_id")
  type    MemoryType

  /// The words on the card: a caption, a label, or the page's title.
  title       String @default("")
  /// The body of a written memory; unused by the media kinds.
  description String @default("")
  /// Free text, deliberately not a timestamp: the sender writes the moment
  /// the way they would say it ("Été 2019", "le soir du 12 mars").
  date        String @default("")

  /// Path of the media relative to the storage root, e.g. "images/ab12.webp".
  /// Serialised to a URL by the API — the column never holds a host.
  mediaUrl     String? @map("media_url")
  thumbnailUrl String? @map("thumbnail_url")
  posterUrl    String? @map("poster_url")
  mimeType     String? @map("mime_type")

  /// Seconds, for voices and films.
  duration Float?
  width    Int?
  height   Int?

  /// Place in the album — ONE sequence per pearl, across every type.
  ///
  /// It used to be numbered inside each type, and the viewer read the four
  /// groups one after another: every photograph, then every film, then the
  /// voices, then the written pages. That discarded the only ordering the
  /// author ever expressed — the order they added things in. A gift built as
  /// photo, voice, photo, note came back as photo, photo, voice, note.
  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pearl Pearl @relation(fields: [pearlId], references: [id], onDelete: Cascade)

  /// How the album is read back.
  @@index([pearlId, position])
  /// Still used: the per-kind counts, and the limit checks that guard them.
  @@index([pearlId, type, position])
  @@map("memories")
}

enum SessionKind {
  /// Handed out when the passcode is accepted. Lets the bearer READ the
  /// memories of that one pearl, and nothing else.
  VIEW
  /// Handed out when the builder password is accepted. Lets the bearer edit
  /// that one pearl until it expires or the gift is sealed.
  BUILDER
}

/// The bytes of one stored file, keyed by the same storage path the Memory
/// rows already carry ("images/ab12.webp"). The database is the storage, so a
/// pearl and its photographs, films and voices are backed up, moved and
/// deleted as one thing.
model MediaBlob {
  path      String   @id
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media_blobs")
}

/// A bearer token bound to exactly one pearl, so a token minted for one gift
/// is worth nothing against another. Sealing a gift deletes every session it
/// had, which is what makes the temporary password stop working at once.
model Session {
  token     String      @id
  pearlId   Int         @map("pearl_id")
  kind      SessionKind @default(BUILDER)
  createdAt DateTime    @default(now()) @map("created_at")
  expiresAt DateTime    @map("expires_at")

  pearl Pearl @relation(fields: [pearlId], references: [id], onDelete: Cascade)

  @@index([pearlId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One wrong guess. Counted per IP and per pearl inside a rolling window —
/// this is what keeps a five-letter love-note of a passcode safe.
model UnlockAttempt {
  id        Int      @id @default(autoincrement())
  slug      String
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug, ip, createdAt])
  @@map("unlock_attempts")
}
