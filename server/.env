# ============================================================
# SEAORA — La Perle (backend)
# Copy this file to `.env` inside server/ and fill it in.
# Never commit the real `.env`.
# ============================================================

# ---------- database ----------
DATABASE_URL=postgresql://postgres:fraj1999@localhost:5432/seaora?schema=public

# ---------- server ----------
NODE_ENV=production
PORT=5001

# Origin the frontend is deployed on (your Netlify URL) — required for CORS,
# otherwise the browser blocks every request the client makes.
CLIENT_URL=https://seaora.tn/

# This server's own reachable address — gets baked into media/QR/share URLs
# sent to the client. Without it those come back as relative paths, which
# resolve against Netlify's origin instead of this one, and media breaks.
PUBLIC_URL=http://54.37.159.225:5001

# Proxy hops to trust for the client IP (unlock throttle). 1 behind a single
# nginx/Caddy/Cloudflare hop, 0 when reached directly.
TRUST_PROXY=0

# ---------- secrets ----------
PASSCODE=perle
ADMIN_KEY=local-dev-admin-key-please-change-me
REFERENCE_PEPPER=local-dev-reference-pepper-change-me

# ---------- storage ----------
STORAGE_DRIVER=database
UPLOAD_DIR=./uploads

# ---------- upload limits ----------
MAX_IMAGES=24
MAX_IMAGE_MB=12
MAX_AUDIOS=8
MAX_AUDIO_MB=20
MAX_VIDEOS=6
MAX_VIDEO_MB=120
MAX_NOTES=24
