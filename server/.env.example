# ============================================================
# SEAORA — La Perle (backend)
# Copy this file to `.env` inside server/ and fill it in.
# Never commit the real `.env`.
# ============================================================

# ---------- database ----------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://seaora:seaora@localhost:5432/seaora?schema=public

# ---------- server ----------
NODE_ENV=production
PORT=5000

# Origin the frontend is deployed on (e.g. your Netlify URL). Required in
# production for CORS — without it, cross-origin requests are rejected.
CLIENT_URL=https://your-site.netlify.app

# Public base URL of THIS server, as people actually reach it.
# QR codes, share links and (when set) media URLs are built from it.
# Leave unset only for same-host development, where it falls back to the
# request host.
PUBLIC_URL=https://api.yourdomain.com

# Proxy hops to trust for the client IP (unlock throttle). 1 behind a single
# nginx/Caddy/Cloudflare hop in front of this server, 0 when reached directly.
TRUST_PROXY=0

# ---------- secrets ----------
# The passcode for the built-in demo pearl (seeded by `npm run db:seed`).
PASSCODE=perle

# Administration key — REQUIRED to open /admin. Choose something long and
# random: openssl rand -hex 32
ADMIN_KEY=change-me-to-something-long-and-random

# Pepper the reference's unique index is derived under.
# SET IT ONCE AND LEAVE IT — changing it makes every stored reference
# unmatchable. openssl rand -hex 32
REFERENCE_PEPPER=change-me-once-and-never-again

# ---------- storage ----------
# "database" keeps bytes in PostgreSQL (media_blobs); "local" writes under
# UPLOAD_DIR.
STORAGE_DRIVER=database
UPLOAD_DIR=./uploads

# ---------- upload limits ----------
MAX_IMAGES=24
MAX_IMAGE_MB=12
MAX_AUDIOS=8
MAX_AUDIO_MB=20
MAX_VIDEOS=6
MAX_VIDEO_MB=120
MAX_NOTES=24
