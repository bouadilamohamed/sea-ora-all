# ============================================================
# SEAORA — La Perle
# Copy this file to `.env` at the project root and fill it in.
# Never commit the real `.env`.
# ============================================================

# ---------- database ----------
# PostgreSQL connection string used by Prisma (server + CLI).
DATABASE_URL=postgresql://seaora:seaora@localhost:5432/seaora?schema=public

# ---------- server ----------
PORT=5000

# Where the browser reaches the CLIENT. Used for CORS in development,
# when Vite serves the app on its own origin.
CLIENT_URL=http://localhost:5173

# Public base URL of THIS server, as people actually reach it.
# QR codes and share links are built from it, so behind a reverse proxy or a
# tunnel this must be the address a phone can open — not "localhost".
# Leave unset in development: links then fall back to the request host, and
# media is served through relative /m/... URLs (which Vite proxies).
# PUBLIC_URL=https://perle.example.com

# Number of proxy hops to trust for the client IP (used by the unlock
# throttle). 1 is right behind a single nginx / Caddy / Cloudflare tunnel.
# Use 0 when the server is reached directly.
TRUST_PROXY=0

# ---------- secrets ----------
# The passcode for the built-in demo pearl (seeded by `npm run db:seed`).
# The gate validates it SERVER-SIDE — it is never sent to the browser.
PASSCODE=perle

# Administration key — REQUIRED to open /admin, where gifts are generated.
# Choose something long and random. Without it, /admin refuses to open.
ADMIN_KEY=change-me-to-something-long-and-random

# The pepper the reference's UNIQUE index is derived under.
#
# A reference is engraved on one object, so it names one gift and no other.
# Enforcing that needs one deterministic value per reference — and a bare
# digest of a short engraved code would be trivially reversed from a stolen
# database, so it is keyed with this.
#
# SET IT ONCE AND LEAVE IT. Changing it makes every reference already stored
# unmatchable, and duplicate detection silently stops working on those rows.
REFERENCE_PEPPER=change-me-once-and-never-again

# ---------- storage ----------
# Storage driver.
#   database  the bytes live in PostgreSQL, in `media_blobs`, keyed by the
#             same relative path the memory rows carry. One backup takes the
#             gift with its photographs, its films and its voices.
#   local     the bytes live under UPLOAD_DIR.
# The media service is written against a four-method interface, so an
# S3-compatible driver can be added without touching the controllers.
STORAGE_DRIVER=database

# Root folder for uploaded media — only read by the "local" driver.
# Sub-folders images/, videos/ and audio/ are created automatically.
UPLOAD_DIR=./uploads

# ---------- upload limits ----------
MAX_IMAGES=24
MAX_IMAGE_MB=12
MAX_AUDIOS=8
MAX_AUDIO_MB=20
MAX_VIDEOS=6
MAX_VIDEO_MB=120
MAX_NOTES=24

# ---------- client (build-time, read by Vite) ----------
# Absolute API origin for a client deployed on a different host than the API.
# Leave unset when the server also serves the built client (the default), or
# in development, where Vite proxies /api and /m to the server.
# VITE_API_URL=https://perle.example.com
